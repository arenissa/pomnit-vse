# Токен от @BotFather (обязательно)
BOT_TOKEN=123456789:AA...

# Часовой пояс по умолчанию для новых пользователей (IANA)
TIMEZONE=Europe/Moscow

# За сколько минут до срока напоминать
REMIND_BEFORE_MINUTES=30

# Как часто планировщик проверяет базу, секунды
POLL_INTERVAL_SECONDS=5

# Повторные напоминания: интервал в минутах (0 — выключить) и сколько раз максимум
REPEAT_AFTER_MINUTES=10
MAX_REPEATS=3

# Время по умолчанию, если в заметке указана дата без времени
DEFAULT_TIME=12:00

# Путь к файлу БД (по умолчанию data/reminders.db)
# DATABASE_PATH=/absolute/path/reminders.db

# Ограничить доступ: список Telegram ID через запятую (пусто — доступ всем)
# ALLOWED_USER_IDS=111111111,222222222
